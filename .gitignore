# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Bundled whisper model is ~77 MB — too big for vanilla git.
# See ios/whisper/README.md for the fetch step.
/assets/models/*.bin

# Claude Code harness internal state (agent transcripts, worktrees).
.claude/

# Spike artifacts that are either build outputs or cloned upstream source.
# spike.dart / wrapper.cpp are kept as binding-pattern reference.
/.spikes/whisper.cpp/
/.spikes/*.dylib

# Xcode/SwiftPM resolved state — regenerated by Xcode on open.
ios/Runner.xcworkspace/xcshareddata/swiftpm/

# Decomposer interview transcript — not load-bearing for the app and contains
# personal interview content that doesn't belong in a public repo.
manifest.json
